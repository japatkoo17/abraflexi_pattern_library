        {
            "id": 11,
            "module": "code:ExecuteCode",
            "version": 0,
            "parameters": {},
            "mapper": {
                "input": [
                    {
                        "name": "pokladni_pohyb",
                        "value": "{{8.body.winstrom.`pokladni-pohyb`}}"
                    },
                    {
                        "name": "zvazek",
                        "value": "{{9.body.winstrom.zavazek}}"
                    },
                    {
                        "name": "abra_firma",
                        "value": "{{22.ABRA_link}}"
                    },
                    {
                        "name": "faktura_prijata",
                        "value": "{{16.body.winstrom.`faktura-prijata`}}"
                    },
                    {
                        "name": "id_spustenia",
                        "value": "{{22.ID_spustenie}}"
                    }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "// --- Začiatok kódu pre Make.com ---\n\n// 1. Načítanie len požadovaných premenných zo vstupu\nconst {\n  pokladni_pohyb,\n  zavazek,\n  abra_firma,\n  faktura_prijata,\n  id_spustenia\n} = input;\n\n// Validácia, či máme k dispozícii názov firmy pre URL\nif (!abra_firma) {\n  throw new Error(\"Chýba vstupná premenná 'abra_firma'!\");\n}\n\n// Základná časť URL adresy\nconst baseUrl = `https://feroveucto0.flexibee.eu/flexi/${abra_firma}`;\n\n// --- Príprava Dátumu a Času ---\nconst now = new Date();\nconst options = {\n  timeZone: 'Europe/Prague',\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false\n};\n\nconst parts = new Intl.DateTimeFormat('sk-SK', options).formatToParts(now);\nconst partMap = {};\nparts.forEach(part => {\n  if (part.type !== 'literal') {\n    partMap[part.type] = part.value;\n  }\n});\nconst aktualnyDatetime = `${partMap.day}-${partMap.month}-${partMap.year} ${partMap.hour}:${partMap.minute}`;\n\n// --- Spracovanie ---\n\nconst vystupneKolekcie = [];\n\n/*\n * Pomocná funkcia, ktorá prejde vstupné pole,\n * vypočíta % sumOsv z celkovej sumy a aplikuje filter.\n */\nconst spracujPole = (arr, evidencia) => {\n  // Bezpečná iterácia (arr || [])\n  (arr || []).forEach(item => {\n\n    // Načítanie súm a prevod na číslo (pre istotu, ak by prišli ako string)\n    const sumOsv = parseFloat(item.sumOsv) || 0;\n    const sumCelkem = parseFloat(item.sumCelkem) || 0;\n\n    // Výpočet percenta\n    let percento = 0;\n    if (sumCelkem !== 0) {\n      percento = (sumOsv / sumCelkem) * 100;\n    }\n\n    // PODMIENKA:\n    // Hľadáme doklady, ktoré NESPĹŇAJÚ podmienku \"sumOsv je v rozmedzí 19 až 21 %\".\n    // Tzn. chceme doklady, kde je percento MENŠIE ako 19 ALEBO VÄČŠIE ako 21.\n    const jeVRozmedzi = percento >= 49 && percento <= 51;\n\n    // Ak je hodnota v rozmedzí (true), tak ju NECHCEME. \n    // Ak nie je v rozmedzí (false), tak ju spracujeme (!jeVRozmedzi).\n    if (!jeVRozmedzi) {\n\n      // 1. Zložíme link\n      const link = `${baseUrl}/${evidencia}/${item.id}/edit`;\n\n      // 2. Vytvoríme objekt\n      const novaKolekcia = {\n        Datetime: aktualnyDatetime,\n        firma: abra_firma,\n        evidencia: evidencia,\n        abralink: link,\n        popis: item.popis,\n        duzpUcto: item.duzpUcto,\n        kontrola: \"KONTROLA 50/50\",\n        id_spustenia: id_spustenia,\n        id_chybny_doklad: item.id\n      };\n\n      // 3. Pridáme kolekciu do hlavného poľa\n      vystupneKolekcie.push(novaKolekcia);\n    }\n  });\n};\n\n// --- Spracovanie len 2 typov dokladov ---\nspracujPole(pokladni_pohyb, \"pokladni-pohyb\");\nspracujPole(zavazek, \"zavazek\");\nspracujPole(faktura_prijata, \"faktura-prijata\");\n// Vraciame pole objektov, ktoré prešli filtrom (teda sú \"chybné\" podľa zadania)\nreturn vystupneKolekcie;\n\n// --- Koniec kódu ---"
            },
            "metadata": {
                "designer": {
                    "x": 1675,
                    "y": 8,
                    "name": "Čáry máry"
                },
                "restore": {
                    "expect": {
                        "input": {
                            "items": [
                                null,
                                null,
                                null,
                                null,
                                null
                            ]
                        },
                        "language": {
                            "mode": "chose",
                            "label": "JavaScript"
                        },
                        "inputFormat": {
                            "label": "Code editor"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "language",
                        "type": "select",
                        "label": "Language",
                        "required": true,
                        "validate": {
                            "enum": [
                                "javascript",
                                "python"
                            ]
                        }
                    },
                    {
                        "name": "input",
                        "spec": {
                            "name": "value",
                            "spec": [
                                {
                                    "name": "name",
                                    "type": "text",
                                    "label": "Name",
                                    "required": true,
                                    "validate": {
                                        "max": 32,
                                        "min": 1,
                                        "pattern": "^[a-zA-Z0-9_]{1,32}$"
                                    }
                                },
                                {
                                    "name": "value",
                                    "type": "any",
                                    "label": "Value"
                                }
                            ],
                            "type": "collection",
                            "label": "Variable"
                        },
                        "type": "array",
                        "label": "Input"
                    },
                    {
                        "name": "dependencies",
                        "spec": {
                            "name": "value",
                            "type": "text",
                            "label": "Dependency",
                            "required": true,
                            "validate": {
                                "max": 214,
                                "min": 1,
                                "pattern": "^[A-Za-z0-9_@\\./<>\\=\\!~\\^+\\-]{1,214}$"
                            }
                        },
                        "type": "array",
                        "label": "Additional dependencies (Enterprise plans only)"
                    },
                    {
                        "name": "inputFormat",
                        "type": "select",
                        "label": "Input format",
                        "required": true,
                        "validate": {
                            "enum": [
                                "editor",
                                "string"
                            ]
                        }
                    },
                    {
                        "name": "codeEditorJavascript",
                        "type": "editor",
                        "label": "Code",
                        "required": true
                    }
                ]
            }
        },
