                "language": "javascript",
                "inputFormat": "editor",
                "dependencies": [],
                "codeEditorJavascript": "// --- Začiatok kódu pre Make.com ---\n\n// Načítanie všetkých potrebných premenných zo vstupu\nconst {\n  FA_prijata,\n  FA_vystavena,\n  pokladni_pohyb,\n  zvazek,\n  banka,\n  abra_firma,\n  ID_spustenia\n} = input;\n\n// Validácia, či máme k dispozícii názov firmy pre URL\nif (!abra_firma) {\n  throw new Error(\"Chýba vstupná premenná 'abra_firma'!\");\n}\n\n// Základná časť URL adresy\nconst baseUrl = `https://feroveucto0.flexibee.eu/flexi/${abra_firma}`;\n\n// --- Príprava Dátumu a Času ---\n// 1. Získame aktuálny dátum\nconst now = new Date();\n\n// 2. Nastavíme požadované formátovanie a časovú zónu\nconst options = {\n  timeZone: 'Europe/Prague',\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false\n};\n\n// 3. Použijeme Intl.DateTimeFormat na získanie jednotlivých častí.\nconst parts = new Intl.DateTimeFormat('sk-SK', options).formatToParts(now);\n\n// 4. Prevedieme pole častí na jednoduchý objekt (mapu)\nconst partMap = {};\nparts.forEach(part => {\n  if (part.type !== 'literal') {\n    partMap[part.type] = part.value;\n  }\n});\n\n// 5. Zložíme finálny string vo formáte DD-MM-YYYY HH:mm\nconst aktualnyDatetime = `${partMap.day}-${partMap.month}-${partMap.year} ${partMap.hour}:${partMap.minute}`;\n\n// --- Spracovanie ---\n\n// Toto bude hlavné pole, ktoré vrátime.\nconst vystupneKolekcie = [];\n\n/*\n * Pomocná funkcia, ktorá prejde vstupné pole\n * a pre každú položku pridá nový OBJEKT do poľa 'vystupneKolekcie'.\n */\nconst spracujPole = (arr, evidencia) => {\n  // Bezpečná iterácia (arr || [])\n  (arr || []).forEach(item => {\n    \n    // 1. Zložíme link\n    const link = `${baseUrl}/${evidencia}/${item.id}/edit`;\n    \n    // 2. Vytvoríme objekt presne podľa požadovanej štruktúry\n    // UPRAVENÉ: Pridané polia 'popis' a 'duzpUcto'\n    const novaKolekcia = {\n      Datetime: aktualnyDatetime,\n      firma: abra_firma,\n      evidencia: evidencia,\n      abralink: link,\n      popis: item.popis,       // <--- Pridané\n      duzpUcto: item.duzpUcto,  // <--- Pridané\n      kontrola: \"KONTROLA ZAUC. DOKL.\",\n      ID_spustenia: ID_spustenia,\n      id_chybny_doklad: item.id\n    };\n    \n    // 3. Pridáme kolekciu do nášho hlavného poľa\n    vystupneKolekcie.push(novaKolekcia);\n  });\n};\n\n// --- Spracovanie všetkých 5 typov dokladov ---\nspracujPole(FA_prijata, \"faktura-prijata\");\nspracujPole(FA_vystavena, \"faktura-vydana\");\nspracujPole(pokladni_pohyb, \"pokladni-pohyb\");\nspracujPole(zvazek, \"zavazek\"); \nspracujPole(banka, \"banka\");\n\n// Vraciame pole objektov.\nreturn vystupneKolekcie;\n\n// --- Koniec kódu ---"
